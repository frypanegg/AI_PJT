# 이 파일을 secrets.toml로 복사한 뒤 실제 값을 채워 넣으세요.
# secrets.toml은 .gitignore에 등록되어 있어 git에 올라가지 않습니다.
#
# 챗봇의 "일반 리더십/조직관리 질문 웹검색 Tool"(web_advisor.py)에 사용됩니다.
# 두 키가 모두 있어야 활성화되며, 없으면 자동으로 비활성화되고 14개 진단 영역
# 관련 답변은 이 키 없이도 기존처럼 완전히 로컬에서 동작합니다.
#
# 참고: 이 프로젝트는 상위 폴더의 .env 파일(OPENAI_API_KEY, TAVILY_API_KEY)을
# 자동으로 찾아서 쓰므로, 그 .env가 이미 있다면 이 파일은 따로 설정하지 않아도 됩니다.

OPENAI_API_KEY = "sk-..."
TAVILY_API_KEY = "tvly-..."
# OPENAI_MODEL = "gpt-4.1-mini"
